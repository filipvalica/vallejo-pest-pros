---
import { siteConfig } from '../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalSchema from '../components/LocalSchema.astro';
import CallTrackingScript from '../components/CallTrackingScript.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const base = Astro.site?.href ?? 'https://example.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, base).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteConfig.businessName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- GA4 -->
    {siteConfig.ga4MeasurementId && siteConfig.ga4MeasurementId !== 'G-XXXXXXXXXX' && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ga4MeasurementId}`}
        ></script>
        <script define:vars={{ gaMeasurementId: siteConfig.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}

    <!-- Accent color CSS variable — swap accentColor in site.config.ts -->
    <style define:vars={{ accentColor: siteConfig.accentColor }}>
      :root {
        --color-accent: var(--accentColor);
      }
    </style>

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <LocalSchema />
  </head>
  <body class="font-sans bg-white text-gray-900 antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CallTrackingScript />
  </body>
</html>
