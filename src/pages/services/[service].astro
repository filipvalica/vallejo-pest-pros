---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { siteConfig } from '../../site.config';
import { getCollection, getEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { service: entry.slug },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await entry.render();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": entry.data.title,
  "description": entry.data.description,
  "provider": {
    "@type": siteConfig.schema.businessType,
    "name": siteConfig.businessName,
    ...(siteConfig.phoneActive ? { "telephone": siteConfig.phone } : {}),
  },
  "areaServed": {
    "@type": "City",
    "name": siteConfig.primaryCity,
  },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.site?.href ?? "/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${Astro.site?.href ?? ""}services/` },
    { "@type": "ListItem", "position": 3, "name": entry.data.title },
  ],
};
---

<BaseLayout
  title={entry.data.heroHeading ?? `${entry.data.title} in ${siteConfig.primaryCity}, ${siteConfig.state}`}
  description={entry.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <!-- Page hero -->
  <section class="bg-gray-50 border-b border-gray-200 py-12 px-4">
    <div class="max-w-3xl mx-auto">
      <nav class="text-xs text-gray-500 mb-4">
        <a href="/" class="hover:underline">Home</a> /
        <a href="/#services" class="hover:underline">Services</a> /
        <span class="text-gray-700">{entry.data.title}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        {entry.data.heroHeading ?? `${entry.data.title} in ${siteConfig.primaryCity}, ${siteConfig.state}`}
      </h1>
      <p class="text-lg text-gray-600 mb-6">{entry.data.description}</p>
      {siteConfig.phoneActive ? (
        <a
          href={`tel:${siteConfig.phone}`}
          class="inline-flex items-center gap-2 text-white px-5 py-3 rounded font-semibold text-sm transition-opacity hover:opacity-90"
          style="background-color: var(--color-accent);"
        >
          Call now — {siteConfig.phone}
        </a>
      ) : (
        <a
          href="/contact"
          class="inline-flex items-center gap-2 text-white px-5 py-3 rounded font-semibold text-sm transition-opacity hover:opacity-90"
          style="background-color: var(--color-accent);"
        >
          Get a free quote
        </a>
      )}
    </div>
  </section>

  <!-- MDX content -->
  <div class="max-w-3xl mx-auto px-4 py-12 prose prose-gray max-w-none">
    <Content />
  </div>

  <!-- FAQ section rendered from frontmatter -->
  {entry.data.faqs && entry.data.faqs.length > 0 && (
    <section class="bg-gray-50 border-t border-gray-100 py-12 px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
          {entry.data.title} — common questions
        </h2>
        <dl class="space-y-5">
          {entry.data.faqs.map(({ q, a }) => (
            <div class="border-b border-gray-200 pb-5">
              <dt class="font-semibold text-gray-900 mb-1">{q}</dt>
              <dd class="text-gray-600 text-sm leading-relaxed">{a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <!-- Bottom CTA -->
  {siteConfig.formActive && (
    <section class="py-14 px-4 bg-white">
      <div class="max-w-md mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">
          Get a free {entry.data.title.toLowerCase()} quote
        </h2>
        <p class="text-gray-500 text-center mb-6 text-sm">
          Serving {siteConfig.primaryCity} and the surrounding area.
        </p>
        <ContactForm />
      </div>
    </section>
  )}
</BaseLayout>
