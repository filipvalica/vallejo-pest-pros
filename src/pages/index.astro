---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteConfig } from '../site.config';
import { getCollection } from 'astro:content';

const serviceEntries = await getCollection('services');
const services = serviceEntries.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${siteConfig.niche.replace(/-/g, ' ')} in ${siteConfig.primaryCity} ${siteConfig.state}`}
  description={`${siteConfig.businessName} provides ${siteConfig.services[0]?.toLowerCase() ?? 'professional services'} in ${siteConfig.primaryCity}, ${siteConfig.state}. Free estimates available.`}
>
  <Hero />
  <TrustBar />

  <!-- Services grid -->
  <section id="services" class="py-14 px-4 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Our services</h2>
      <p class="text-gray-500 text-center mb-8 max-w-xl mx-auto">
        {siteConfig.primaryCity}, {siteConfig.state} and the surrounding area.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((entry) => (
          <ServiceCard
            title={entry.data.title}
            description={entry.data.description}
            slug={entry.slug}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-14 px-4 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-10 text-center">How it works</h2>
      <ol class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        {[
          { step: "1", label: "Call or submit a quote request" },
          { step: "2", label: "We assess and give you a firm price" },
          { step: "3", label: "Job done — same day when possible" },
        ].map(({ step, label }) => (
          <li class="text-center">
            <span
              class="inline-flex items-center justify-center h-12 w-12 rounded-full text-white font-bold text-xl mb-3"
              style="background-color: var(--color-accent);"
            >
              {step}
            </span>
            <p class="text-gray-700 font-medium">{label}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Service area list -->
  <section class="py-14 px-4 bg-white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Areas we serve</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {siteConfig.serviceArea.map((city) => (
          <a
            href={`/areas/${city.toLowerCase().replace(/\s+/g, '-')}`}
            class="border border-gray-200 rounded px-3 py-1 text-sm text-gray-700 hover:border-gray-400 transition-colors"
          >
            {city}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Lead form -->
  {siteConfig.formActive && (
    <section id="quote" class="py-14 px-4 bg-gray-50">
      <div class="max-w-md mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Get a free quote</h2>
        <p class="text-gray-500 text-center mb-6 text-sm">
          We call back within 1 hour during business hours.
        </p>
        <ContactForm />
      </div>
    </section>
  )}
</BaseLayout>
