---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { siteConfig } from '../../site.config';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const areas = await getCollection('areas');
  return areas.map((entry) => ({
    params: { city: entry.slug },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await entry.render();

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.site?.href ?? "/" },
    { "@type": "ListItem", "position": 2, "name": "Areas", "item": `${Astro.site?.href ?? ""}areas/` },
    { "@type": "ListItem", "position": 3, "name": entry.data.city },
  ],
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <section class="bg-gray-50 border-b border-gray-200 py-12 px-4">
    <div class="max-w-3xl mx-auto">
      <nav class="text-xs text-gray-500 mb-4">
        <a href="/" class="hover:underline">Home</a> /
        <span class="text-gray-700">{entry.data.city}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        {entry.data.title}
      </h1>
      <p class="text-lg text-gray-600 mb-6">{entry.data.description}</p>
      <a
        href={`tel:${siteConfig.phone}`}
        class="inline-flex items-center gap-2 text-white px-5 py-3 rounded font-semibold text-sm transition-opacity hover:opacity-90"
        style="background-color: var(--color-accent);"
      >
        Call now — {siteConfig.phone}
      </a>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 py-12 prose prose-gray max-w-none">
    <Content />
  </div>

  <!-- Links to primary service pages -->
  <section class="py-10 px-4 bg-gray-50 border-t border-gray-100">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-xl font-bold text-gray-900 mb-4">
        Services available in {entry.data.city}
      </h2>
      <ul class="flex flex-wrap gap-3">
        {siteConfig.services.map((s) => (
          <li>
            <a
              href={`/services/${s.toLowerCase().replace(/\s+/g, '-')}`}
              class="border border-gray-200 rounded px-3 py-1 text-sm text-gray-700 hover:border-gray-400 transition-colors"
            >
              {s}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-14 px-4 bg-white">
    <div class="max-w-md mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">
        Free quote for {entry.data.city}
      </h2>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
