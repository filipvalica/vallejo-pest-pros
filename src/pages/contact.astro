---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteConfig } from '../site.config';
---

<BaseLayout
  title="Contact us"
  description={`Contact ${siteConfig.businessName} for ${siteConfig.services[0]?.toLowerCase() ?? 'service'} in ${siteConfig.primaryCity}, ${siteConfig.state}. Get in touch today.`}
>
  <div class={`max-w-3xl mx-auto px-4 py-14 ${siteConfig.formActive ? 'grid grid-cols-1 md:grid-cols-2 gap-12' : ''}`}>
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Contact us</h1>
      <p class="text-gray-600 mb-6">
        {siteConfig.formActive
          ? "Ready to schedule or have a question? Call us directly or fill out the form."
          : "Have a question about our service area? Reach out by email and we'll get back to you."}
      </p>

      <dl class="space-y-4 text-sm">
        {siteConfig.phoneActive && (
          <div>
            <dt class="font-semibold text-gray-700">Phone</dt>
            <dd>
              <a href={`tel:${siteConfig.phone}`} class="hover:underline" style="color: var(--color-accent);">
                {siteConfig.phone}
              </a>
            </dd>
          </div>
        )}
        <div>
          <dt class="font-semibold text-gray-700">Email</dt>
          <dd>
            <a href={`mailto:${siteConfig.email}`} class="hover:underline" style="color: var(--color-accent);">
              {siteConfig.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-700">Hours</dt>
          <dd class="text-gray-600">Monday – Sunday, 7 am – 7 pm</dd>
        </div>
        <div>
          <dt class="font-semibold text-gray-700">Service area</dt>
          <dd class="text-gray-600">{siteConfig.serviceArea.join(', ')}</dd>
        </div>
      </dl>
    </div>

    {siteConfig.formActive && (
      <div>
        <ContactForm />
      </div>
    )}
  </div>
</BaseLayout>
