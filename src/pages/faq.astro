---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
import { getCollection } from 'astro:content';

// Aggregate FAQs from all service content files
const serviceEntries = await getCollection('services');
const allFaqs = serviceEntries.flatMap((e) => e.data.faqs ?? []);

// FAQ JSON-LD schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": a,
    },
  })),
};
---

<BaseLayout
  title="Frequently asked questions"
  description={`Common questions about ${siteConfig.niche.replace(/-/g, ' ')} in ${siteConfig.primaryCity}, ${siteConfig.state}. ${siteConfig.businessName} answers them here.`}
>
  {allFaqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <div class="max-w-2xl mx-auto px-4 py-14">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Frequently asked questions</h1>

    {allFaqs.length === 0 ? (
      <p class="text-gray-500">No FAQs yet — add <code>faqs</code> arrays to your service MDX files.</p>
    ) : (
      <dl class="space-y-6">
        {allFaqs.map(({ q, a }) => (
          <div class="border-b border-gray-100 pb-6">
            <dt class="font-semibold text-gray-900 mb-2">{q}</dt>
            <dd class="text-gray-600 text-sm leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-12 rounded-lg bg-gray-50 border border-gray-200 p-6 text-center">
      <p class="text-gray-700 font-medium mb-3">Still have questions?</p>
      {siteConfig.phoneActive ? (
        <a
          href={`tel:${siteConfig.phone}`}
          class="inline-block text-white px-5 py-2 rounded font-semibold text-sm transition-opacity hover:opacity-90"
          style="background-color: var(--color-accent);"
        >
          Call {siteConfig.phone}
        </a>
      ) : (
        <a
          href="/contact"
          class="inline-block text-white px-5 py-2 rounded font-semibold text-sm transition-opacity hover:opacity-90"
          style="background-color: var(--color-accent);"
        >
          Get in touch
        </a>
      )}
    </div>
  </div>
</BaseLayout>
