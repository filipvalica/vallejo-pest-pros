---
import { siteConfig } from '../site.config';
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="font-bold text-lg text-gray-900 hover:text-accent transition-colors">
      {siteConfig.businessName}
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-700">
      <a href="/#services" class="hover:text-accent transition-colors">Services</a>
      <a href="/faq" class="hover:text-accent transition-colors">FAQ</a>
      <a href="/contact" class="hover:text-accent transition-colors">Contact</a>
    </nav>

    <a
      href={`tel:${siteConfig.phone}`}
      class="bg-accent text-white px-4 py-2 rounded text-sm font-semibold hover:opacity-90 transition-opacity"
      style={`background-color: var(--color-accent);`}
    >
      {siteConfig.phone.replace(/\+1-?/, '')}
    </a>
  </div>
</header>
