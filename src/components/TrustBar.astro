---
import { siteConfig } from '../site.config';

const items = [
  siteConfig.trust.responseTime,
  siteConfig.trust.certifications,
  siteConfig.trust.guarantee,
].filter(Boolean);
---

<section class="bg-white border-b border-gray-100 py-4 px-4">
  <div class="max-w-5xl mx-auto flex flex-wrap justify-center gap-x-8 gap-y-2">
    {items.map((item) => (
      <span class="flex items-center gap-2 text-sm text-gray-700 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" style="color: var(--color-accent);">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        {item}
      </span>
    ))}
  </div>
</section>
